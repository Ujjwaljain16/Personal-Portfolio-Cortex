# Copy to .env.local and fill in. Never prefix secrets with NEXT_PUBLIC_ — that
# inlines the value into the client bundle.

# Gemini API key for /api/ask (server only).
GOOGLE_GENERATIVE_AI_API_KEY=

# Devin MCP key used by /api/ask for engineering-record retrieval (server only).
DEVIN_API_KEY=

# Optional. Only used server-side, only for public GitHub endpoints, to raise
# the rate limit. Use a fine-grained token with NO permissions (public read).
# The site works without it.
GITHUB_TOKEN=
